{
  "name": "kushoniyon-stroyhub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:noenv": "NEXT_TELEMETRY_DISABLED=1 SKIP_ENV_VALIDATION=1 next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
