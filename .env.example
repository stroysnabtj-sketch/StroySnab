DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kushoniyon
APP_URL=http://localhost:3000
# Public canonical website used by sitemap, robots and page metadata.
SITE_URL=https://www.stroysnab.tj

# For Railway, match the target port under Settings → Networking.
# PORT=8080

STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Login codes use HTTPS gateways. Add only the channels you configure.
AUTH_EMAIL_SEND_URL=
AUTH_EMAIL_SEND_TOKEN=
AUTH_EMAIL_PROVIDER=
AUTH_SMS_SEND_URL=
AUTH_SMS_SEND_TOKEN=
AUTH_SMS_PROVIDER=
AUTH_SMS_SENDER=
AUTH_SMS_TEMPLATE_ID=
AI_QUOTATION_ENABLED=false
AI_QUOTATION_DAILY_LIMIT=20
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Order SMS is separate from login and requires a scheduled worker.
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_PROVIDER=payom
# NOTIFICATIONS_SMS_SEND_URL=https://gateway.payom.tj/api/message
NOTIFICATIONS_SMS_SEND_URL=
NOTIFICATIONS_SMS_SEND_TOKEN=
NOTIFICATIONS_SMS_SENDER=
NOTIFICATIONS_SMS_ORDER_TEMPLATE_ID=
NOTIFICATIONS_SMS_ADMIN_TEMPLATE_ID=
NOTIFICATIONS_SMS_DAILY_LIMIT=100
NOTIFICATIONS_SMS_CALLBACK_SECRET=
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_RESEND_API_KEY=
NOTIFICATIONS_EMAIL_FROM=
NOTIFICATIONS_EMAIL_DAILY_LIMIT=100
NOTIFICATIONS_SEND_AFTER=
# Use the same independent, random secret on the website and notification worker.
ORDER_GUEST_LINK_SECRET=

TRUSTED_PROXY=
# Railway public HTTP ingress sets X-Real-IP. Enable only behind a trusted ingress.
TRUSTED_PROXY_HEADER=

# Optional replacement for the reverse-address provider. Public Nominatim is rate limited and cached.
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Require password + email code for employee sessions
STAFF_EMAIL_OTP_REQUIRED=true
